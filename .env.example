# AI Provider Keys
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TRANSCRIPTION_PROVIDER=auto
LLM_PROVIDER=groq

# Google OAuth 2.0 Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL Database (Required for persistent storage on Vercel / Neon / Supabase)
# If left empty, SQLite (local database) is used as automatic fallback
DATABASE_URL=postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
